# Backend server
SERVER_PORT=8085

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wikilive_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# MWS Backend API
MWS_BACKEND_API_KEY=

# MWS Tables API
MWS_API_KEY=
NEXT_PUBLIC_MWS_API_KEY=

# Wiki Datasheets in MWS Tables
NEXT_PUBLIC_WIKI_DATASHEET_ID=
NEXT_PUBLIC_WIKI_COMMENTS_DATASHEET_ID=
NEXT_PUBLIC_WIKI_VERSIONS_DATASHEET_ID=
NEXT_PUBLIC_WIKI_ACCESS_DATASHEET_ID=

# MWS GPT API (AI features)
MWS_GPT_API_KEY=
MWS_GPT_MODEL_HINT=gpt-oss-20b
MWS_GPT_MODEL_BLOCK=qwen2.5-72b-instruct

# --- Security & Auth (Basic Auth for API) ---
# Default password for demo users (encoded with BCrypt in code)
SECURITY_DEMO_PASSWORD=123
# Comma-separated list of demo usernames (API keys)
SECURITY_DEMO_USERS=uskO2BIAF6jREwNMJr95MSQ,demo_user_2,demo_user_3

# --- CORS & WebSocket ---
# Allowed origins for frontend (comma-separated, no spaces)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# WebSocket endpoint path
WEBSOCKET_PATH=/ws

# --- App Features ---
# Enable/disable public read access (true/false)
FEATURE_PUBLIC_READ=true
